# ===========================================================================
# 嵌入层（严格对齐 ragent bootstrap/src/main/resources/application.yaml）
# 默认候选链：qwen-emb-8b (siliconflow) -> qwen-emb-local (ollama) -> text-embedding-3-large (aihubmix)
# 维度：1536（与 ragent rag.default.dimension 一致）
# 熔断：2 次失败 / 30s 开放（对应 ragent ai.selection.failure-threshold / open-duration-ms）
# ===========================================================================

# --- 硅基流动（首选，OpenAI 兼容）---
SILICONFLOW_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=
SILICONFLOW_ENDPOINTS={"embedding":"/v1/embeddings","chat":"/v1/chat/completions"}

# --- Ollama 本地（降级，max_batch 不限；不发送 encoding_format）---
OLLAMA_URL=http://localhost:11434
OLLAMA_ENDPOINTS={"embedding":"/v1/embeddings"}

# --- AIHubMix（兜底，OpenAI 兼容）---
AIHUBMIX_URL=https://aihubmix.com/v1
AIHUBMIX_API_KEY=
AIHUBMIX_ENDPOINTS={"embedding":"/v1/embeddings"}

# --- 选模型 / 维度 ---
EMBEDDING_DEFAULT_MODEL=qwen-emb-8b
EMBEDDING_DIM=1536

# --- 候选链（JSON 数组；覆盖默认值时使用）---
EMBEDDING_CANDIDATES=[
  {"id":"qwen-emb-8b","provider":"siliconflow","model":"Qwen/Qwen3-Embedding-8B","dimension":1536,"priority":1},
  {"id":"qwen-emb-local","provider":"ollama","model":"qwen3-embedding:8b-fp16","dimension":1536,"priority":2},
  {"id":"text-embedding-3-large","provider":"aihubmix","model":"text-embedding-3-large","dimension":1536,"priority":3}
]

# --- 熔断 ---
EMBEDDING_FAILURE_THRESHOLD=2
EMBEDDING_OPEN_DURATION_MS=30000
